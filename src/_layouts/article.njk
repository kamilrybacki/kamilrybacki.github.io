---
layout: base.njk
bodyClass: article-page
---

{% block head %}{% endblock %}

<header class="home-nav article-nav">
  <div class="home-shell home-nav-inner">
    <a href="/" class="home-brand">K.Rybacki</a>
    <nav class="home-links" aria-label="Social links">
      <a href="https://www.linkedin.com/in/kamil-andrzej-rybacki/" class="home-btn home-btn-ghost" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/kamilrybacki" class="home-btn home-btn-solid" target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
  </div>
</header>

<article class="article-shell">
  <a href="/" class="article-back-link">← Back to home</a>

  <header class="article-header">
    <h1>{{ title }}</h1>
    <hr class="article-rule">
    <div class="article-meta">
      <time class="article-date">{{ date | dateFormat }}</time>
      {% if category %}
      <span class="article-meta-dot">·</span>
      <span class="article-category">{{ category }}</span>
      {% endif %}
    </div>
  </header>

  <div class="article-content">
    {{ content | safe }}
  </div>

  <div class="article-navigation">
    <a href="/" class="home-btn home-btn-ghost article-nav-btn">← Back to home</a>
  </div>
</article>
