---
layout: base.njk
bodyClass: article-page
---

{% block head %}{% endblock %}

<header class="site-header">
  <div class="header-top">
    <a href="/" class="site-title">Kamil Rybacki</a>
    <div class="social-links">
      <a href="https://www.linkedin.com/in/kamil-andrzej-rybacki/" class="social-link" aria-label="LinkedIn">
        <img src="https://s.magecdn.com/social/mb-linkedin.svg" alt="LinkedIn" width="20" height="20">
      </a>
      <a href="https://github.com/kamilrybacki" class="social-link" aria-label="GitHub">
        <img src="https://s.magecdn.com/social/mb-github.svg" alt="GitHub" width="20" height="20">
      </a>
    </div>
  </div>
  <div class="site-description">
    <span class="dotted-line"></span>
    <p>Turning complex backend puzzles into fast, reliable Python</p>
  </div>
</header>

<article>
  <a href="/" class="back-link">&#8592; Back</a>

  <header class="article-header">
    <h1>{{ title }}</h1>
    <hr class="dotted-separator">
    <div class="article-meta">
      <time class="article-date">{{ date | dateFormat }}</time>
      {% if category %}
      <span class="article-meta-dot">&middot;</span>
      <span class="article-category">{{ category }}</span>
      {% endif %}
    </div>
  </header>

  <div class="article-content">
    {{ content | safe }}
  </div>

  <div class="article-navigation">
    <a href="/" class="back-link">&#8592; Back</a>
  </div>
</article>
