<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} - {% endif %}Kamil Rybacki</title>
  <meta name="description" content="{{ description or 'Personal blog and projects of Kamil Rybacki - Software Engineer' }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;900&family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="/styles/prism.css">
  <script src="/public/article-filters.js" defer></script>
  {% block head %}{% endblock %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <div class="container">
    {% if title != "Home" and bodyClass != "article-page" %}
    <header class="header">
      <a href="/" class="site-title">Kamil Rybacki</a>
    </header>
    {% endif %}

    <main>
      {{ content | safe }}
    </main>

    <footer class="footer">
      <p>&copy; 2026 Kamil Rybacki</p>
    </footer>
  </div>
</body>
</html>
