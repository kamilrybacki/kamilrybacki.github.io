---
layout: base.njk
title: Home
bodyClass: home-page
---

<header class="home-nav">
  <div class="home-shell home-nav-inner">
    <a href="/" class="home-brand">K.Rybacki</a>
    <nav class="home-links" aria-label="Social links">
      <a href="https://www.linkedin.com/in/kamil-andrzej-rybacki/" class="home-btn home-btn-ghost" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/kamilrybacki" class="home-btn home-btn-solid" target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
  </div>
</header>

<script>window.__tickerPhrases__={{ tickerPhrases | dump | safe }};</script>
<div class="ticker-wrap" aria-hidden="true">
  <div class="ticker-track" id="tickerTrack"></div>
</div>

<section class="home-hero home-shell">
  <h1>KAMIL RYBACKI</h1>
  <div class="home-hero-divider" aria-hidden="true"></div>

  <div class="home-hero-grid">
    <div class="home-hero-copy">
      <p>
        Happily married to <strong>backends</strong>, <strong>data pipelines</strong>,
        and the <strong>infrastructure</strong> that glues the overall <strong>ETL madness</strong>.
        Still figuring out where <strong>AI</strong> actually fits in all of that.
      </p>
    </div>

    <aside class="home-hero-visual" aria-hidden="true">
      <img class="home-hero-svg" src="/public/images/ascii-art.svg" alt="ASCII art" loading="lazy" />
    </aside>
  </div>

</section>

<section class="home-writings home-shell articles-section">
  <div class="home-section-title">
    <h2>Writings</h2>
    <div class="line" aria-hidden="true"></div>
    <div class="diamond" aria-hidden="true"></div>
  </div>

  <div class="filter-search-wrap" role="search">
    <input
      type="text"
      class="filter-input"
      placeholder="Filter by category…"
      autocomplete="off"
      spellcheck="false"
      aria-label="Filter articles by category"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-haspopup="listbox"
    >
    <ul class="filter-suggestions" role="listbox" aria-label="Category suggestions" hidden>
      {% for cat in collections.articleCategories %}
      <li class="filter-suggestion-item" data-category="{{ cat }}" role="option" tabindex="-1">{{ cat }}</li>
      {% endfor %}
    </ul>
  </div>

  <div class="articles-container">
    <ul class="article-list home-article-grid">
      {% for article in collections.articles | head(10) %}
      <li class="article-item home-article-card" data-category="{{ article.data.category or 'Misc' }}">
        <a href="{{ article.url }}" class="home-article-link">
          <div class="home-article-head">
            <h3 class="article-title">{{ article.data.title }}</h3>
            {% if article.data.category %}
            <span class="home-article-tag">{{ article.data.category }}</span>
            {% endif %}
          </div>
          <div class="article-meta">
            <time class="article-date">{{ article.data.date | dateFormat }}</time>
          </div>
          {% if article.data.description %}
          <p class="article-description">{{ article.data.description }}</p>
          {% endif %}
        </a>
      </li>
      {% endfor %}
    </ul>

    <div class="no-articles-message">
      <p>No articles found in this category.</p>
    </div>
  </div>

  {% if collections.articles.length > 10 %}
  <p class="home-view-all"><a href="/articles/">View all articles →</a></p>
  {% endif %}
</section>
